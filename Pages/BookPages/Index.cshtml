@page
@model Chiuariu_Medeea_Cezara_Lab2.Pages.BookPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<form method="get">
    <label asp-for="AuthorID">Author</label>
    <select asp-for="AuthorID" asp-items="Model.AuthorsList">
        <option value="">Toți autorii</option>
    </select>
    <button type="submit" class="btn btn-primary">Filtrează</button>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].Author)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Book[0].Price)
            </th>
            <th>
               @Html.DisplayNameFor(model => model.Book[0].PublishingDate)
            </th>
            <th>
            @Html.DisplayNameFor(model => model.Book[0].Publisher.PublisherName)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Book) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            <td>
                 @Html.DisplayFor(model => item.Author.FirstName)
                 @Html.DisplayFor(model => item.Author.LastName)
                
            </td>
            <td>
                @Html.DisplayFor(model => item.Price)
            </td>
            <td>
               @Html.DisplayFor(modelItem => item.PublishingDate)
            </td>
            <td>
              @Html.DisplayFor(modelItem => item.Publisher.PublisherName)
          </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
